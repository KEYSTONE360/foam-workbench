                                            <Label Content="기준 면적 Aref (m²)"/>
                                            <TextBox x:Name="ReferenceAreaBox" Text="1"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <Label Content="기준 길이 lRef (m)"/>
                                            <TextBox x:Name="ReferenceLengthBox" Text="1"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
