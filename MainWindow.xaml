                                             FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                             SpellCheck.IsEnabled="False"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="04  엔진 기능">
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.35*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="OpenFOAM 런타임 카탈로그" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,14" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap" LineHeight="19"
                                           Text="현재 연결된 엔진의 런타임 선택 테이블을 직접 조회합니다. 추가 라이브러리가 설치되면 목록에도 자동 반영됩니다."/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="CatalogCategoryCombo" SelectedIndex="1" SelectedValuePath="Tag">
                                    <ComboBoxItem Tag="-solvers">솔버 모듈</ComboBoxItem>
                                    <ComboBoxItem Tag="-functionObjects">functionObjects</ComboBoxItem>
                                    <ComboBoxItem Tag="-scalarBCs">스칼라 경계조건</ComboBoxItem>
                                    <ComboBoxItem Tag="-vectorBCs">벡터 경계조건</ComboBoxItem>
                                    <ComboBoxItem Tag="-fvModels">fvModels</ComboBoxItem>
                                    <ComboBoxItem Tag="-fvConstraints">fvConstraints</ComboBoxItem>
                                    <ComboBoxItem Tag="-tables">런타임 테이블 종류</ComboBoxItem>
                                    <ComboBoxItem Tag="-switches">디버그·정보·최적화 스위치</ComboBoxItem>
                                    <ComboBoxItem Tag="-all">전체 런타임 선택 항목</ComboBoxItem>
                                </ComboBox>
                                <Button Grid.Column="1" Content="엔진에서 조회" Click="LoadRuntimeCatalog_Click"
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBox Grid.Row="2" x:Name="CatalogSearchBox" Margin="0,10,0,10"
                                     TextChanged="CatalogSearchBox_TextChanged"
                                     ToolTip="이름 또는 라이브러리 검색"/>
                            <ListBox Grid.Row="3" x:Name="RuntimeCatalogList"
                                     ItemsSource="{Binding RuntimeCatalogItems}"
                                     Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1" Padding="4" FontFamily="Cascadia Mono, Consolas"
                                     ItemContainerStyle="{StaticResource CatalogListItem}"
                                     SelectionChanged="RuntimeCatalogList_SelectionChanged"/>
                            <TextBlock Grid.Row="4" x:Name="CatalogStatusText" Margin="0,10,0,0"
                                       Foreground="{StaticResource MutedBrush}" Text="엔진에서 목록을 조회하세요."/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="58"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="CatalogSelectionText" Text="항목을 선택하세요" FontWeight="SemiBold"/>
                                    <TextBlock Text="foamInfo의 설명·소스·예제 위치" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="정보·예제 조회" Click="LookupRuntimeInfo_Click"
                                        VerticalAlignment="Center" Padding="11,6"/>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="RuntimeInfoBox" IsReadOnly="True"
                                     FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                     AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     Background="#090E15" Foreground="#E4EBF3" Padding="16"/>
                            <Border Grid.Row="2" Background="{StaticResource InsetBrush}" Padding="14" CornerRadius="0,0,12,12">
                                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Text="선택 항목은 사전 편집기에서 직접 구성하거나, 결과 변수 탭의 사용자 functionObject에 원문으로 추가할 수 있습니다. UI는 입력을 제한하지 않습니다."/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="05  런타임">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="실행 백엔드" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,18" Foreground="{StaticResource MutedBrush}"
                                           TextWrapping="Wrap"
                                           Text="GUI는 계산을 대신하지 않습니다. 아래 런타임의 실제 OpenFOAM 실행 파일을 호출합니다."/>

                                <Label Content="백엔드"/>
