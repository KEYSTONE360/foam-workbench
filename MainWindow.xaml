                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#07111B"/>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Tag="Wsl">
                                        <TextBlock Text="WSL2 (권장 · 로컬 Ubuntu)" Foreground="#07111B"/>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Docker">
                                        <TextBlock Text="Docker (선택 · 컨테이너)" Foreground="#07111B"/>
                                    </ComboBoxItem>
                                </ComboBox>

                                <Grid x:Name="WslSettingsPanel">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.6*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <Label Content="WSL 배포판"/>
                                        <TextBox x:Name="WslDistributionBox"/>
