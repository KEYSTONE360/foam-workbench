                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,7,0">
                                            <Label Content="피치 축 pitchAxis"/>
                                            <TextBox x:Name="PitchAxisBox" Text="0 1 0" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <Label Content="회전 중심 CofR (m)"/>
                                            <TextBox x:Name="CentreOfRotationBox" Text="0 0 0" FontFamily="Consolas"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="저장 위치" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" LineHeight="20"
                                               Text="힘·계수 이력은 case/postProcessing 아래에, Q·와도·y+·벽면 전단응력 같은 장은 OpenFOAM 시간 폴더에 기록되어 ParaView에서 바로 선택할 수 있습니다."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="수렴 · 벽면 · 파생장" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                                               Text="필요한 OpenFOAM functionObject만 선택합니다."/>
                                    <UniformGrid Columns="2">
                                        <CheckBox x:Name="ResidualsCheck" IsChecked="True" Content="잔차 U, p, k, ω"/>
                                        <CheckBox x:Name="WallShearStressCheck" IsChecked="True" Content="벽면 전단응력"/>
                                        <CheckBox x:Name="YPlusCheck" IsChecked="True" Content="난류 y+"/>
                                        <CheckBox x:Name="QCriterionCheck" IsChecked="True" Content="Q criterion"/>
                                        <CheckBox x:Name="VorticityCheck" IsChecked="True" Content="와도 vorticity"/>
                                        <CheckBox x:Name="TurbulenceIntensityCheck" Content="난류 강도장"/>
                                        <CheckBox x:Name="FieldAverageCheck" Content="시간 평균·변동장"/>
                                    </UniformGrid>
                                    <Label Content="시간평균 대상 필드" Margin="0,12,0,0"/>
                                    <TextBox x:Name="AveragedFieldsBox" Text="U p" FontFamily="Cascadia Mono, Consolas"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="사용자 functionObject" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" LineHeight="19"
                                               Text="OpenFOAM 사전 블록을 입력하면 해석하거나 축약하지 않고 system/FoamWorkbenchFunctions에 그대로 포함합니다. 엔진 기능 탭에서 현재 설치본의 전체 목록을 볼 수 있습니다."/>
