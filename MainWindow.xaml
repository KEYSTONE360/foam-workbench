                                    <TextBlock x:Name="EditorDirtyMark" Text="  ● 수정됨" Foreground="{StaticResource WarningBrush}"
                                               Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="다시 불러오기" Click="ReloadEditor_Click" Margin="0,0,7,0" Padding="10,6"/>
                                    <Button Content="저장" Click="SaveEditor_Click" Style="{StaticResource PrimaryButton}" Padding="12,6"/>
                                </StackPanel>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="DictionaryEditor" FontFamily="Cascadia Mono, Consolas"
                                     FontSize="13" AcceptsReturn="True" AcceptsTab="True"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     TextChanged="DictionaryEditor_TextChanged" IsEnabled="False"
                                     BorderThickness="0" Padding="16" TextWrapping="NoWrap"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="MonitorTab" Header="08  모니터">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.15*"/>
                        <RowDefinition Height="0.85*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.8*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,6,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="잔차 이력 (Initial residual) · 휠 확대/축소" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ResidualLogStatusText" Text="케이스를 열면 최신 로그를 자동 복구합니다."
                                                   FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="410"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="PythonResidualPlotButton" Content="Python 상세" Click="GeneratePythonResidualPlot_Click"
                                                Padding="9,5" Margin="0,0,7,0"/>
                                        <Button Content="이전 로그 선택" Click="LoadResidualLog_Click" Padding="9,5"/>
                                        <Button Content="초기화" Click="ClearMonitor_Click" Padding="9,5" Margin="7,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <controls:ResidualPlot Grid.Row="1" x:Name="ResidualChart" Margin="1"/>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="6,0,0,0" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="46"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="최근 잔차" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0"/>
                                <DataGrid Grid.Row="1" x:Name="ResidualGrid" ItemsSource="{Binding ResidualSummaries}"
                                          AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0"
                                          Foreground="#F4F8FC" FontSize="12" RowHeight="32"
                                          AlternationCount="2" SelectionMode="Single">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#202A39"/>
                                            <Setter Property="Foreground" Value="#F4F8FC"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Padding" Value="9,8"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground" Value="#EAF2FA"/>
                                            <Setter Property="Padding" Value="8,5"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#36427D"/>
                                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="변수" Binding="{Binding Field}" Width="*"/>
                                        <DataGridTextColumn Header="초기 잔차" Binding="{Binding Initial, StringFormat=0.00E+00}" Width="94"/>
                                        <DataGridTextColumn Header="최종 잔차" Binding="{Binding Final, StringFormat=0.00E+00}" Width="94"/>
                                        <DataGridTextColumn Header="표본" Binding="{Binding Samples}" Width="58"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="실행 콘솔" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="로그 지우기" Click="ClearConsole_Click" Padding="9,5"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <TextBox Grid.Row="1" x:Name="ConsoleBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                                     FontSize="11" AcceptsReturn="True" TextWrapping="NoWrap" BorderThickness="0"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     Background="#090E15" Foreground="#D7E0EA"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Border Grid.Row="3" Background="#0A0F16" BorderBrush="#263548" BorderThickness="0,1,0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Text="준비됨" Foreground="{StaticResource MutedBrush}"
                           FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="원본 계산 엔진 · 사전 무손실" Foreground="{StaticResource AccentBrush}"
                           FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
