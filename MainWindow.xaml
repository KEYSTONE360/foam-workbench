                                     Text="postProcess -func &quot;patchIntegrate(p)&quot;"/>
                            <Button Grid.Column="2" Content="실행" Click="RunCustomCommand_Click" Margin="8,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="07  사전 편집">
