                                <Label Content="Windows ParaView 실행 파일" Margin="0,14,0,0"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ParaViewPathBox"/>
                                    <Button Grid.Column="1" Content="찾기" Click="BrowseParaView_Click" Margin="8,0,0,0"/>
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Label Content="병렬 프로세스 수"/>
                                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11"
                                                   Text="decomposeParDict의 subdomains와 일치해야 합니다."/>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="ProcessCountBox" VerticalContentAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                                    <Button Content="설정 저장" Click="SaveSettings_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="연결 테스트" Click="ProbeRuntime_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="케이스 무결성" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,4,0,16" Foreground="{StaticResource MutedBrush}"
                                               Text="OpenFOAM 표준 디렉터리와 controlDict를 검사합니다."/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource InsetCard}" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="0/" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBlock x:Name="ZeroStatus" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Style="{StaticResource InsetCard}" Margin="3,0">
                                            <StackPanel>
                                                <TextBlock Text="constant/" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBlock x:Name="ConstantStatus" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource InsetCard}" Margin="6,0,0,0">
                                            <StackPanel>
                                                <TextBlock Text="system/" FontFamily="Consolas" FontWeight="Bold"/>
                                                <TextBlock x:Name="SystemStatus" Text="—" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock x:Name="CaseValidationText" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Text="케이스를 열면 상세 검사가 표시됩니다."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="계산 보존 원칙" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               LineHeight="21"
                                               Text="• blockMesh, snappyHexMesh, checkMesh를 원본 그대로 실행&#10;• controlDict의 application/solver를 자동 감지&#10;• MPI 병렬 계산과 reconstructPar 지원&#10;• fvSchemes, fvSolution, 난류·열물성 사전을 임의 변경하지 않음&#10;• 모든 고급 사전을 원문 편집기로 완전하게 노출"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="06  실행">
                <Grid Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="계산 파이프라인" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="필요한 원본 OpenFOAM 유틸리티만 선택하세요. 순서대로 실행됩니다."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="선택 실행" Click="RunPipeline_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                                    <Button Content="중지" Click="Stop_Click" Style="{StaticResource DangerButton}"/>
                                </StackPanel>
                            </Grid>
                            <ListBox Grid.Row="1" x:Name="PipelineList" ItemsSource="{Binding PipelineSteps}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="11" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="34"/>
                                                    <ColumnDefinition Width="190"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsEnabled}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Command}" FontFamily="Consolas" FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Description}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Status}" HorizontalAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="사용자 명령" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
